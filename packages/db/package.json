{
  "name": "@lifeos/db",
  "version": "0.0.1",
  "private": true,
  "description": "Drizzle ORM schema, migrations, seeds, DB client",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seeds/dev-seed.ts",
    "db:seed:workouts": "tsx src/seeds/workout-seed.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lifeos/domain-workouts": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "postgres": "^3.4.0",
    "@lifeos/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
