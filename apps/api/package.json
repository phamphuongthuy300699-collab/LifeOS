{
  "name": "@lifeos/api",
  "version": "0.0.1",
  "private": true,
  "description": "LifeOS REST API — Hono + TypeScript",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
