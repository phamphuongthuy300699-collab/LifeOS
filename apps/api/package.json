    "@lifeos/db": "workspace:*",
    "@lifeos/domain-calendar": "workspace:*",
    "@lifeos/domain-contacts": "workspace:*",
    "@lifeos/domain-learning": "workspace:*",
    "@lifeos/domain-nutrition": "workspace:*",
    "@lifeos/domain-notes": "workspace:*",
    "@lifeos/domain-projects": "workspace:*",
    "@lifeos/domain-tasks": "workspace:*",
    "@lifeos/domain-workouts": "workspace:*",
    "@lifeos/integrations-google": "workspace:*",
    "@lifeos/shared": "workspace:*",
    "bullmq": "^5.76.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "ioredis": "^5.10.1",
    "zod": "^3.24.0"
