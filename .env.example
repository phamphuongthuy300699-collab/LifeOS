# LifeOS — Environment Variables

# Database
DATABASE_URL=postgresql://lifeos:lifeos@localhost:5432/lifeos

# Redis (for BullMQ jobs)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_DEMO_MODE=false
# For internal debugging only. Keep false in public environments.
NEXT_PUBLIC_ENABLE_DEV_HEADER_AUTH=false
NODE_ENV=development

# AI (future, Sprint 8)
# AI_PROVIDER=openai
# AI_API_KEY=
